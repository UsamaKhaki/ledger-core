# Supabase — when these are set, the app uses Supabase for auth + data (RLS).
# Without them it falls back to the in-memory mock provider (prototype).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never exposed to the browser. Used for admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app. Used to build the email-confirmation redirect
# (must also be added under Supabase -> Auth -> URL Configuration -> Redirect URLs).
# Local: http://localhost:3000 - Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe billing — when the secret key + both price IDs are set, real Checkout
# is used and subscription state is driven by the webhook. Without them, the app
# stays in local-simulation mode (dev). All server-only; never sent to browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Run `node scripts/create-stripe-products.mjs` to generate these price IDs.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Email (Resend) — powers due-date reminders + weekly progress emails.
# Without RESEND_API_KEY, no emails are sent (the cron still runs, as a no-op).
RESEND_API_KEY=
EMAIL_FROM="Ledger <reminders@yourdomain.com>"
# Secret that guards the cron endpoint. Set the SAME value in Vercel; Vercel Cron
# automatically sends it as `Authorization: Bearer <CRON_SECRET>`.
# Schedule it (once/day) e.g. in vercel.ts:
#   crons: [{ path: "/api/cron/reminders", schedule: "0 13 * * *" }]
CRON_SECRET=

# Rate limiting (Upstash Redis) — shared across serverless instances. Without
# these, rate limiting falls back to per-instance in-memory counters (fine for
# a single server / local dev). Create a free Redis at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry error monitoring — with no DSN, monitoring is fully off (no network).
# DSN is public (used by the browser too). Get it from your Sentry project.
NEXT_PUBLIC_SENTRY_DSN=
# The following enable source-map upload (readable stack traces) at build time.
# Leave blank to skip upload; builds still succeed. Never commit the auth token.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
